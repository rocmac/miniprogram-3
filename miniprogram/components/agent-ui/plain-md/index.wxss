.plain-md {
  width: 100%;
}

.plain-md__p,
.plain-md__h1,
.plain-md__h2,
.plain-md__h3,
.plain-md__h4 {
  display: block;
  width: 100%;
  text-align: left;
  word-wrap: break-word;
  word-break: break-word;
  white-space: pre-wrap;
  line-height: 1.8;
}

.plain-md__p {
  font-size: 32rpx;
  margin: 0 0 16rpx;
}

.plain-md__h1,
.plain-md__h2,
.plain-md__h3,
.plain-md__h4 {
  font-weight: 700;
  white-space: normal;
  margin: 16rpx 0 8rpx;
}

.plain-md__h1 {
  font-size: 40rpx;
}

.plain-md__h2 {
  font-size: 36rpx;
}

.plain-md__h3,
.plain-md__h4 {
  font-size: 34rpx;
}
