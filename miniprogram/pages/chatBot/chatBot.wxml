<view class="chat-page" wx:if="{{allowed}}">
  <agent-ui
    id="agent"
    agentConfig="{{agentConfig}}"
    showBotAvatar="{{showBotAvatar}}"
    chatMode="{{chatMode}}"
    modelConfig="{{modelConfig}}"
    envShareConfig="{{envShareConfig}}"
  ></agent-ui>
</view>
<view class="access-check" wx:else>
  <text>{{checkError || "正在确认使用权限"}}</text>
  <view wx:if="{{checkError}}" class="retry" bindtap="retryAccess">重试</view>
</view>
