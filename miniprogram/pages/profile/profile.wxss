page {
  height: 100%;
  background: #f7f7f8;
}

.page {
  min-height: 100%;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-btn {
  width: 136rpx;
  height: 136rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  flex-shrink: 0;
  line-height: 1;
  overflow: visible;
}

.avatar-btn::after {
  border: none;
}

.avatar-clip {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #ececf1;
}

.avatar-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  text-align: center;
}

.user-fields {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #8e8ea0;
  margin-bottom: 8rpx;
}

.nickname {
  width: 100%;
  height: 72rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  border-bottom: 1rpx solid #eee;
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a0a0a0;
  line-height: 1.4;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f3f5;
}

.row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.row:first-child {
  padding-top: 0;
}

.row-label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #6b6b76;
}

.row-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1a1a1a;
  word-break: break-all;
}

.row-value.ok {
  color: #0a7a3e;
}

.row-value.muted {
  color: #a0a0a0;
}

.mono {
  font-size: 24rpx;
  font-family: ui-monospace, Menlo, monospace;
}

.phone-btn {
  margin-top: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 28rpx;
}

.phone-btn::after {
  border: none;
}

.manage-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.manage-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.manage-desc {
  font-size: 24rpx;
  color: #8e8ea0;
}

.footer-hint {
  padding: 8rpx 8rpx 0;
  font-size: 22rpx;
  color: #a0a0a0;
  line-height: 1.5;
}
