<view class="page">
  <view class="card user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <view class="avatar-clip">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
        <view class="avatar-mask">换头像</view>
      </view>
    </button>
    <view class="user-fields">
      <text class="label">微信昵称</text>
      <input
        class="nickname"
        type="nickname"
        maxlength="20"
        placeholder="点击填写微信昵称"
        value="{{nickName}}"
        bindblur="onNicknameBlur"
        bindchange="onNicknameChange"
      />
      <text class="hint">头像和昵称需你点选授权后才会写入后台</text>
    </view>
  </view>

  <view class="card manage-card" wx:if="{{userInfo.isAdmin}}" bindtap="goAdmin">
    <text class="manage-title">用户管理</text>
    <text class="manage-desc">查看头像和昵称，决定谁可以使用</text>
  </view>

  <view class="card">
    <view class="row">
      <text class="row-label">使用权限</text>
      <text class="row-value {{userInfo.isAdmin || userInfo.accessStatus === 'approved' ? 'ok' : 'muted'}}">{{accessText}}</text>
    </view>
    <view class="row">
      <text class="row-label">登录状态</text>
      <text class="row-value {{userInfo.openid ? 'ok' : 'muted'}}">{{userInfo.openid ? '已识别微信身份' : '未记录'}}</text>
    </view>
    <view class="row">
      <text class="row-label">OpenID</text>
      <text class="row-value mono" selectable>{{maskedOpenid}}</text>
    </view>
    <view class="row" wx:if="{{userInfo.unionid}}">
      <text class="row-label">UnionID</text>
      <text class="row-value mono" selectable>{{maskedUnionid}}</text>
    </view>
    <view class="row">
      <text class="row-label">登录次数</text>
      <text class="row-value">{{userInfo.loginCount || 0}} 次</text>
    </view>
    <view class="row">
      <text class="row-label">最近登录</text>
      <text class="row-value">{{lastLoginText}}</text>
    </view>
    <view class="row">
      <text class="row-label">首次记录</text>
      <text class="row-value">{{createdAtText}}</text>
    </view>
    <view class="row">
      <text class="row-label">设备</text>
      <text class="row-value">{{deviceText}}</text>
    </view>
  </view>

  <view class="footer-hint">头像和昵称需要你点选后才会保存。未通过审核时不能使用对话。</view>
</view>
