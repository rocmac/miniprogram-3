page {
  height: 100%;
  background: #f7f7f8;
}

.page {
  min-height: 100%;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.summary {
  margin: 8rpx 8rpx 20rpx;
  font-size: 26rpx;
  color: #6b6b76;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #a0a0a0;
  font-size: 28rpx;
}

.card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ececf1;
  flex-shrink: 0;
}

.meta {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  color: #6b6b76;
  background: #f3f3f5;
}

.tag.pending {
  color: #9a5b00;
  background: #fff3df;
}

.tag.ok {
  color: #0a7a3e;
  background: #e8f6ee;
}

.tag.admin {
  color: #fff;
  background: #1a1a1a;
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a0a0a0;
}

.actions {
  flex-shrink: 0;
}

.btn {
  min-width: 96rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.allow {
  background: #1a1a1a;
  color: #fff;
}

.deny {
  background: #f3f3f5;
  color: #6b6b76;
}
