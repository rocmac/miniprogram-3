page {
  height: 100%;
  background: #f7f7f8;
}

.page {
  min-height: 100%;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  color: #6b6b76;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-hit {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #ececf1;
}

.avatar-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  text-align: center;
}

.privacy-btn {
  margin-top: 24rpx;
}

.user-fields {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #8e8ea0;
  margin-bottom: 8rpx;
}

.nickname {
  width: 100%;
  height: 72rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  border-bottom: 1rpx solid #eee;
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a0a0a0;
  line-height: 1.4;
}

.wechat-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin: 0 0 24rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #fff;
  color: #1a1a1a;
  font-size: 30rpx;
  line-height: 88rpx;
}

.wechat-avatar::after {
  border: none;
}

.wechat-avatar-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.submit {
  margin-top: 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 30rpx;
}

.submit::after {
  border: none;
}

.refresh {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6b6b76;
}
